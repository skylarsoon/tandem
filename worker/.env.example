# Copy to .env and fill privately. Process environment values take precedence.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
APIFY_TOKEN=
APIFY_ACTOR_BUILD=0.0.141
# SpacetimeDB database live runs plan against (local: http://127.0.0.1:3000, tandem-dev).
# The worker token's identity must be registered by the database owner with add_worker.
STDB_URL=
STDB_DB=
STDB_WORKER_TOKEN=
# Shared only between the worker service and TypeScript dispatcher.
WORKER_WAKE_TOKEN=
