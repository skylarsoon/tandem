FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /opt/tandem
COPY optimizer/ ./optimizer/
COPY worker/pyproject.toml ./worker/pyproject.toml
COPY worker/src/ ./worker/src/
RUN pip install ./optimizer './worker[live]' && python -c "from tandem_worker.rules import decisions; from tandem_worker.serve import ServeConfig; assert decisions()['categories']; assert ServeConfig().limits.actor_runs == 40"
CMD ["python", "-m", "tandem_worker.cloud"]
