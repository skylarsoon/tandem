{
  "version": 1,
  "about": "What candidates of each category carry, named exactly as their facts (Candidate fields). Rules may only refer to these. Types: money (integer cents), int, number, bool, time (local HH:MM), epoch (seconds), date (local YYYY-MM-DD), text. shared_by_setting: for a shared pick, people without their own need for this attribute share it, that many to one (a room setting), so the pick must hold their explicit needs plus their share, rounded up. trip_bound: the attribute must sit inside the trip's dates (room settings start_date/end_date) for every pick: by_end means on or before the end date (e.g. arriving), from_start on or after the start date (e.g. leaving to go home). search_date: a person's own firm rule on this attribute moves their search: outbound searches no earlier than their earliest allowed date, return no later than their latest. lowest/highest: how a preference for the lowest or highest value reads (\"travel time as short as possible\"). same_as: how a preference to share a pick with another member reads (\"the same flight as Alex\").",
  "categories": {
    "FLIGHT": {
      "total_cents": {
        "type": "money",
        "label": "fare",
        "lowest": "as cheap as possible"
      },
      "arrival_local": {
        "type": "time",
        "label": "landing time"
      },
      "arrival_epoch": {
        "type": "epoch",
        "label": "landing",
        "lowest": "as early as possible",
        "highest": "as late as possible"
      },
      "departure_epoch": {
        "type": "epoch",
        "label": "departure"
      },
      "stops": {
        "type": "int",
        "label": "connections"
      },
      "baggage_included": {
        "type": "bool",
        "label": "checked bag included"
      },
      "checked_bags_included": {
        "type": "int",
        "label": "checked bags included"
      },
      "departure_date": {
        "type": "date",
        "label": "departure date",
        "search_date": "outbound"
      },
      "arrival_date": {
        "type": "date",
        "label": "arrival date",
        "trip_bound": "by_end"
      },
      "duration_minutes": {
        "type": "int",
        "label": "travel time",
        "lowest": "as short as possible"
      },
      "return_departure_epoch": {
        "type": "epoch",
        "label": "return departure"
      },
      "return_arrival_epoch": {
        "type": "epoch",
        "label": "return landing"
      },
      "return_departure_date": {
        "type": "date",
        "label": "return date",
        "trip_bound": "from_start",
        "search_date": "return"
      },
      "return_arrival_date": {
        "type": "date",
        "label": "date back home",
        "search_date": "return"
      },
      "return_stops": {
        "type": "int",
        "label": "return connections"
      },
      "return_duration_minutes": {
        "type": "int",
        "label": "travel time home",
        "lowest": "as short as possible"
      },
      "flight_identity": {
        "type": "text",
        "label": "flight",
        "same_as": "the same flight as"
      }
    },
    "STAY": {
      "total_cents": {
        "type": "money",
        "label": "total price"
      },
      "capacity": {
        "type": "int",
        "label": "guests"
      },
      "bedrooms": {
        "type": "int",
        "label": "bedrooms",
        "shared_by_setting": "people_per_bedroom"
      },
      "rating": {
        "type": "number",
        "label": "rating",
        "range": [
          0,
          5
        ]
      },
      "free_cancellation": {
        "type": "bool",
        "label": "free cancellation"
      }
    },
    "TRANSFER": {
      "total_cents": {
        "type": "money",
        "label": "price"
      },
      "capacity": {
        "type": "int",
        "label": "seats"
      }
    },
    "ACTIVITY": {
      "total_cents": {
        "type": "money",
        "label": "price per person"
      },
      "rating": {
        "type": "number",
        "label": "rating",
        "range": [
          0,
          5
        ]
      }
    },
    "DINNER": {
      "total_cents": {
        "type": "money",
        "label": "price per person"
      },
      "rating": {
        "type": "number",
        "label": "rating",
        "range": [
          0,
          5
        ]
      }
    }
  },
  "aggregates": {
    "my_cost": {
      "type": "money",
      "label": "your share of the whole trip",
      "about": "Everything this person pays across the decisions: their own picks plus their share of split ones."
    }
  }
}
